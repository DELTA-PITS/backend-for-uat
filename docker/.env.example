# Application
EXPOSE_PORT=41012
BUILD_DATE=2026-07-28
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=20971520

# Schema changes are an explicit deployment step (python -m trustmark.infra.schema migrate).
# true = the app migrates itself on startup. For local/CI fresh databases ONLY; leave it unset
# (= false) on any real server, where startup just checks the schema and refuses to start if outdated.
SCHEMA_AUTO_APPLY=true

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=trustmark
POSTGRES_USER=trustmark
POSTGRES_PASSWORD=trustmark

# Keycloak
KEYCLOAK_USER=admin
KEYCLOAK_PASS=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/nextjs-kc
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/nextjs-kc
KEYCLOAK_AUDIENCE=account

# Local Anvil blockchain (local / CI / current production until the official cutover)
BLOCKCHAIN_RPC_URL=http://anvil:8545
# Anvil's well-known deterministic dev key - public, NEVER use it on a real chain.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Required. The backend refuses to start if the RPC reports a different chain ID.
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME="Local development chain (Anvil)"
BLOCKCHAIN_EXPLORER_URL=
# Optional tuning: seconds to wait for a receipt per request (default 45) and the
# number of confirmations required before an anchor counts as confirmed (default 1).
# BLOCKCHAIN_RECEIPT_TIMEOUT_SECONDS=45
# BLOCKCHAIN_CONFIRMATIONS=1

# --- Public rehearsal (Ethereum Sepolia) - used only by docker-compose.sepolia.yml ---
# Put the real values in the server-side .env only; never commit them.
#   SEPOLIA_RPC_URL=https://<provider-sepolia-endpoint-with-your-key>
#   SEPOLIA_PRIVATE_KEY=<dedicated Sepolia-only wallet key>
#   BLOCKCHAIN_CHAIN_ID=11155111
#   BLOCKCHAIN_NETWORK_NAME="Ethereum Sepolia"
#   BLOCKCHAIN_EXPLORER_URL="https://sepolia.etherscan.io"

TEST_MODE=False
