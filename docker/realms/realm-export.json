{
  "realm": "nextjs-kc",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "publisher",
        "description": "Allows document registration and dashboard access"
      }
    ]
  },
  "groups": [
    {
      "name": "publisher",
      "realmRoles": [
        "publisher"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nextjs-web",
      "name": "PITS Frontend",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "pits-local-client-secret",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "test-publisher",
      "enabled": true,
      "email": "test@publisher.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": [
        "publisher"
      ],
      "groups": [
        "/publisher"
      ]
    }
  ],
  "sslRequired": "NONE"
}
